          "alerts-list",
          "visit-assign",
          "task-assign"
        ]
      },
      "approvals": {
        "route": "/mgmt/approvals",
        "functions": [
          "manager-approvals-list",
          "approval-decide"
        ],
        "events": [
          "approval.created"
        ],
        "mobile": true
      },
      "pipeline": {
        "route": "/mgmt/pipeline",
        "functions": [
          "accounts-list",
          "deals-list",
          "deal-upsert",
          "account-get",
          "team-list",
          "territories-list"
        ]
