          "alert-act"
        ],
        "events": [
          "alert.created"
        ]
      },
      "new_shops": {
        "route": "/rep/new-shops",
        "functions": [
          "candidates-list",
          "candidate-act",
          "prospect-search",
          "candidate-add"
        ],
        "events": [
          "candidates.ready"
        ]
      },
      "week": {
        "route": "/rep/week",
        "functions": [
          "visit-plan-get",
          "visit-plan-accept",
          "visit-update"
        ]
      },
      "ai_log": {
        "route": "/rep/ai-log",
        "functions": [
          "ai-actions-list",
          "ai-action-undo"
        ]
      }
    },
    "management": {
      "dashboard": {
        "route": "/mgmt/dashboard",
        "functions": [
          "dashboard-kpis",
          "kpi-drilldown",
          "targets-list",
          "team-list",
          "territories-list"
        ]
      },
