  "screens": {
    "rep": {
      "today": {
        "route": "/rep/today",
        "functions": [
          "today-get",
          "briefing-get",
          "visit-plan-get",
          "my-performance"
        ],
        "events": [
          "briefing.ready",
          "plan.proposed"
        ],
        "offline": true
      },
      "customers": {
        "route": "/rep/customers",
        "functions": [
          "accounts-list",
          "visit-card-get",
          "account-get",
          "contact-upsert",
          "problem-update",
          "order-upsert"
        ]
      },
      "record": {
        "route": "/rep/record",
        "functions": [
          "voice-log-upload",
          "debrief-result-get",
          "ai-action-undo",
          "merc-chat-token"
        ],
        "events": [
          "result_card.ready",
          "voice_log.status"
        ],
        "offline": true,
        "voice_widget": "merc-buddy browser voice (Chat SDK)"
      },
      "approvals": {
        "route": "/rep/approvals",
        "functions": [
          "approvals-list",
          "approval-resolve",
          "approval-status"
        ],
        "events": [
          "approval.created",
          "approval.decided",
          "manager_call.status"
        ]
      },
