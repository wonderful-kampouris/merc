{
  "name": "wonderful-app-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "build:runner": "vite build --mode runner --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "package": "node scripts/package.js",
    "runner": "node runner/server.mjs",
    "test": "node --test \"infra/**/*.test.mjs\" && vitest run",
    "test:unit": "vitest run",
    "sync-contracts": "node scripts/sync-contracts.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@wonderful/ui-base": "^6.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "archiver": "^7.0.1",
    "esbuild": "0.28.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^3.2.7",
    "ws": "^8.18.3"
  },
  "packageManager": "pnpm@10.34.5"
}
