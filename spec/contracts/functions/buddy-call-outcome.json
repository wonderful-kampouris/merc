{
  "slug": "buddy-call-outcome",
  "method": "POST",
  "kind": "http",
  "gate": null,
  "callers": [
    "internal",
    "merc-buddy"
  ],
  "timeout_ms": 30000,
  "priority": "P0",
  "wave": 2,
  "request": {
    "type": "object",
    "properties": {
      "buddy_call_id": {
        "type": "string",
        "format": "uuid"
      },
      "outcome": {
        "type": "string",
        "enum": [
          "answered",
          "no_answer",
          "busy",
          "voicemail",
          "failed"
        ]
      },
      "conversation_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "buddy_call_id",
      "outcome"
    ]
  },
  "response": {
    "type": "object",
    "properties": {
      "buddy_call_id": {
        "type": "string",
        "format": "uuid"
      },
      "fallback": {
        "type": "string",
        "enum": [
          "none",
          "whatsapp",
          "app"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "buddy_call_id",
      "fallback"
    ]
  },
  "reads": [
    "app_user"
  ],
  "writes": [
    "buddy_call"
  ],
  "errors": [],
  "llm": [],
  "integrations": [
    "integration:whatsapp.send_template"
  ],
  "notes": "merc-buddy triggers OnVoicemailDetected / OnEnd on an outbound call. no_answer/busy/voicemail -> one WhatsApp template ping if the rep has WhatsApp, else push + inbox. No call retry."
}
