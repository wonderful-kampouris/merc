{
  "slug": "visit-update",
  "method": "POST",
  "kind": "http",
  "gate": "plan.edit",
  "callers": [
    "app",
    "buddy"
  ],
  "timeout_ms": 30000,
  "priority": "P0",
  "wave": 2,
  "request": {
    "type": "object",
    "properties": {
      "visit_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "account_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "action": {
        "type": "string",
        "enum": [
          "move",
          "skip",
          "add",
          "reorder",
          "done"
        ]
      },
      "date": {
        "anyOf": [
          {
            "type": "string",
            "format": "date"
          },
          {
            "type": "null"
          }
        ]
      },
      "position": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "reason": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "action"
    ]
  },
  "response": {
    "type": "object",
    "properties": {
      "visit": {
        "$ref": "../_defs.json#/$defs/VisitSummary"
      },
      "day_count": {
        "type": "integer"
      },
      "warning": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "visit",
      "day_count"
    ]
  },
  "reads": [],
  "writes": [
    "visit",
    "visit_change"
  ],
  "errors": [],
  "llm": [],
  "integrations": [],
  "notes": "add requires account_id + date. warning when the day exceeds visits_per_day.",
  "scope": "owner"
}
