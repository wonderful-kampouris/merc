{
  "slug": "accounts-list",
  "method": "GET",
  "kind": "http",
  "gate": "accounts.read",
  "callers": [
    "app"
  ],
  "timeout_ms": 30000,
  "priority": "P0",
  "wave": 2,
  "request": {
    "type": "object",
    "properties": {
      "q": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "account_type": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "prospect",
              "customer",
              "lost"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "territory_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "owner_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "at_risk": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "page": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "limit": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false
  },
  "response": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "../_defs.json#/$defs/AccountRef"
        }
      },
      "page": {
        "$ref": "../_defs.json#/$defs/Page"
      }
    },
    "additionalProperties": false,
    "required": [
      "items",
      "page"
    ]
  },
  "reads": [
    "account",
    "account_metrics",
    "account_category"
  ],
  "writes": [],
  "errors": [],
  "llm": [],
  "integrations": [],
  "notes": "",
  "scope": "account"
}
