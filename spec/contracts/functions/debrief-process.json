{
  "slug": "debrief-process",
  "method": "POST",
  "kind": "http",
  "gate": "voicelog.create",
  "callers": [
    "buddy",
    "internal"
  ],
  "timeout_ms": 60000,
  "priority": "P0",
  "wave": 2,
  "request": {
    "type": "object",
    "properties": {
      "voice_log_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "utterance": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "account_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "conversation_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "lat": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "lng": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "language": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "corrects_voice_log_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false
  },
  "response": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "needs_confirmation",
          "failed"
        ]
      },
      "result": {
        "anyOf": [
          {
            "$ref": "../_defs.json#/$defs/ResultCard"
          },
          {
            "type": "null"
          }
        ]
      },
      "candidates": {
        "type": "array",
        "items": {
          "$ref": "../_defs.json#/$defs/AccountRef"
        }
      },
      "question": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "status",
      "candidates"
    ]
  },
  "reads": [
    "account",
    "problem",
    "deal",
    "product",
    "campaign",
    "contact",
    "visit",
    "ai_permission",
    "action_type"
  ],
  "writes": [
    "voice_log",
    "activity",
    "task",
    "problem",
    "deal",
    "deal_stage_history",
    "sales_order",
    "order_line",
    "competitor_signal",
    "contact",
    "campaign_exposure",
    "visit",
    "ai_action",
    "approval",
    "message_approval"
  ],
  "errors": [],
  "llm": [
    "debrief_extraction",
    "draft_message"
  ],
  "integrations": [],
  "notes": "Exactly one of voice_log_id / utterance. corrects_voice_log_id (with utterance = the correction words): code undoes every applied line of that completed debrief, then processes its transcript + ' Correction: ' + utterance for the same account, so a fix never creates a second visit. Target p95 < 20 s. Pushes events result_card.ready."
}
