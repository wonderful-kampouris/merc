{
  "profile": "merc-extract",
  "used_by": [
    "debrief-process"
  ],
  "eval_set": "evals/debrief/",
  "purpose": "Turn the rep's free speech about a visit into proposed actions.",
  "input": {
    "type": "object",
    "properties": {
      "utterance": {
        "type": "string"
      },
      "language_hint": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "today": {
        "type": "string",
        "format": "date"
      },
      "account": {
        "$ref": "../_defs.json#/$defs/AccountRef"
      },
      "open_problems": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "problem_id": {
              "type": "string",
              "format": "uuid"
            },
            "description": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "problem_id",
            "description"
          ]
        }
      },
      "open_deals": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "deal_id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string"
            },
            "stage_code": {
              "type": "string"
            },
            "amount_minor": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "deal_id",
            "title",
            "stage_code"
          ]
        }
      },
      "products": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "product_id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "product_id",
            "name",
            "unit",
            "aliases"
          ]
        }
      },
      "active_campaigns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "campaign_id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string"
            },
            "product_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "campaign_id",
            "title",
            "product_names"
          ]
        }
      },
      "contacts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "contact_id": {
              "type": "string",
              "format": "uuid"
            },
            "full_name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "contact_id",
            "full_name"
          ]
        }
      },
      "competitors": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "utterance",
      "today",
      "account",
      "open_problems",
      "open_deals",
      "products",
      "active_campaigns",
      "contacts",
      "competitors"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "language": {
        "type": "string",
        "enum": [
          "el",
          "en",
          "mixed"
        ]
      },
      "note": {
        "type": "string"
      },
      "problems": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "existing_problem_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "open",
                "in_progress",
                "resolved"
              ]
            },
            "due_date": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "description",
            "status",
            "evidence"
          ]
        }
      },
      "tasks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "due_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "is_customer_promise": {
              "type": "boolean"
            },
            "evidence": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "title",
            "is_customer_promise",
            "evidence"
          ]
        }
      },
      "deal_update": {
        "type": "object",
        "properties": {
          "deal_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "new_deal_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "stage_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "amount_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "expected_close_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "evidence"
        ]
      },
      "order_intent": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "product_text": {
                  "type": "string"
                },
                "quantity": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "product_text"
              ]
            }
          },
          "requested_discount_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "lines",
          "evidence"
        ]
      },
      "competitor_signals": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "competitor_name": {
              "type": "string"
            },
            "statement": {
              "type": "string"
            },
            "price_delta_pct": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "competitor_name",
            "statement",
            "evidence"
          ]
        }
      },
      "contacts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "existing_contact_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "full_name": {
              "type": "string"
            },
            "role_title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "phone": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "email": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "is_decision_maker": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "full_name",
            "evidence"
          ]
        }
      },
      "campaigns_pitched": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "campaign_id": {
              "type": "string",
              "format": "uuid"
            },
            "evidence": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "campaign_id",
            "evidence"
          ]
        }
      },
      "follow_up": {
        "type": "object",
        "properties": {
          "intent": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "email",
              "whatsapp",
              "viber"
            ]
          },
          "contact_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "intent",
          "channel",
          "evidence"
        ]
      },
      "visit_done": {
        "type": "boolean"
      },
      "missing_fields": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "question": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "field",
            "question"
          ]
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "language",
      "note",
      "problems",
      "tasks",
      "deal_update",
      "order_intent",
      "competitor_signals",
      "contacts",
      "campaigns_pitched",
      "follow_up",
      "visit_done",
      "missing_fields"
    ]
  },
  "rules": [
    "Every numeric field must appear literally (or as a number word) in the utterance; otherwise null + a missing_fields entry.",
    "Every non-null item carries an evidence quote copied from the utterance.",
    "Relative dates ('Thursday', 'tomorrow') resolve against `today` in the org timezone.",
    "Use only ids from the input lists; unknown product -> product_id null + product_text.",
    "Code re-validates: evidence must be a substring of the utterance (normalized); numbers in evidence; else drop + ask."
  ],
  "name": "debrief_extraction"
}
