{
  "name": "get_briefing",
  "agent": "merc-buddy",
  "function": "briefing-get",
  "description": "The morning briefing script. Read script_text as is.",
  "parameters": {
    "type": "object",
    "properties": {
      "date": {
        "anyOf": [
          {
            "type": "string",
            "format": "date"
