            {
              "type": "null"
            }
          ]
        },
        "pitch": {
          "anyOf": [
            {
              "$ref": "../_defs.json#/$defs/Pitch"
            },
            {
              "type": "null"
            }
          ]
        },
        "spoken_summary": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "account",
        "contacts",
        "open_problems",
        "open_tasks",
        "recent_orders",
        "metrics",
        "alerts",
        "suggested_products",
        "campaigns",
        "spoken_summary"
      ]
