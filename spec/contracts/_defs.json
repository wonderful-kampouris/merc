      "additionalProperties": false,
      "required": [
        "voice_log_id",
        "account",
        "lines",
        "missing_fields",
        "pending_approvals",
        "spoken_summary",
        "processing_ms"
      ]
    },
    "VisitSummary": {
      "type": "object",
      "properties": {
        "visit_id": {
          "type": "string",
          "format": "uuid"
        },
        "account": {
          "$ref": "../_defs.json#/$defs/AccountRef"
        },
        "planned_date": {
          "type": "string",
          "format": "date"
        },
        "route_position": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "done",
            "skipped"
          ]
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "lng": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "visit_id",
        "account",
        "planned_date",
        "status"
      ]
