    "BriefingItem": {
      "type": "object",
      "properties": {
        "position": {
          "type": "integer"
        },
        "item_type": {
          "type": "string"
        },
        "display_text": {
          "type": "string"
        },
        "ref_table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "item_type",
        "display_text"
      ]
    },
    "Briefing": {
      "type": "object",
      "properties": {
        "briefing_id": {
          "type": "string",
          "format": "uuid"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": [
            "generated",
            "delivered",
            "read"
          ]
