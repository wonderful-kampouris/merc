                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "risk_reasons"
          ]
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "alert_id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "alert_id",
              "type",
              "message"
            ]
          }
        },
        "suggested_products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product_id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "product_id",
              "name",
              "why"
            ]
          }
        },
        "campaigns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "campaign_id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "campaign_id",
              "title",
              "message"
            ]
          }
        },
        "how_to_talk": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dossier": {
          "anyOf": [
            {
              "$ref": "../_defs.json#/$defs/DossierView"
