              "description": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "due_date": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "problem_id",
              "description",
              "status"
            ]
          }
        },
        "open_tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string"
              },
              "due_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
