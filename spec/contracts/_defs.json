{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "not_found",
            "forbidden",
            "validation_failed",
            "needs_confirmation",
            "conflict",
            "upstream_failed",
            "timeout",
            "blocked_by_policy"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "AccountRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "account_type": {
          "type": "string",
          "enum": [
            "prospect",
            "customer",
            "lost"
          ]
        },
        "postal_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "distance_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "account_type"
      ]
    },
    "ActionLine": {
      "type": "object",
      "properties": {
        "ai_action_id": {
          "type": "string",
          "format": "uuid"
        },
        "action_type": {
          "type": "string"
        },
        "action_class": {
          "type": "string",
          "enum": [
            "internal",
            "draft",
            "external",
            "structural",
            "destructive"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "suggested",
            "applied",
            "undone",
            "rejected"
          ]
        },
        "summary": {
          "type": "string"
        },
        "target_table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "undoable": {
          "type": "boolean"
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "ai_action_id",
        "action_type",
        "action_class",
        "status",
        "summary",
        "undoable"
      ]
    },
    "MissingField": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "question": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "question"
      ]
    },
    "ApprovalCard": {
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "customer_message",
            "discount",
            "terms",
            "conversion"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "countered",
            "sent",
            "failed",
            "rejected",
            "expired",
            "escalated"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "live",
            "async"
          ]
        },
        "account": {
          "anyOf": [
            {
              "$ref": "../_defs.json#/$defs/AccountRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_by": {
          "$ref": "../_defs.json#/$defs/UserRef"
        },
        "approver": {
          "$ref": "../_defs.json#/$defs/UserRef"
        },
        "preview": {
          "type": "string"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "recipient": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_limit_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "approved_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "due_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "approval_id",
        "kind",
        "status",
        "mode",
        "requested_by",
        "approver",
        "preview",
        "created_at"
      ]
    },
    "UserRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "full_name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "rep",
            "manager",
            "admin"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "full_name",
        "role"
      ]
    },
    "ResultCard": {
      "type": "object",
      "properties": {
        "voice_log_id": {
          "type": "string",
          "format": "uuid"
        },
        "account": {
          "$ref": "../_defs.json#/$defs/AccountRef"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "../_defs.json#/$defs/ActionLine"
          }
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "$ref": "../_defs.json#/$defs/MissingField"
          }
        },
        "pending_approvals": {
          "type": "array",
          "items": {
            "$ref": "../_defs.json#/$defs/ApprovalCard"
          }
        },
        "spoken_summary": {
          "type": "string"
        },
        "processing_ms": {
          "type": "integer"
        }
