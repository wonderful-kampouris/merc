    "OrderSummary": {
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "order_date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "confirmed",
            "cancelled"
          ]
        },
        "total_minor": {
          "type": "integer"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product_id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "product_id",
              "name",
              "quantity",
              "unit"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "order_id",
        "order_date",
        "status",
        "total_minor",
        "lines"
      ]
    },
    "Pitch": {
      "type": "object",
      "properties": {
        "opening_line": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product_id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "product_id",
              "name",
              "why"
            ]
          }
        },
        "objections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "objection": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "objection",
              "answer"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "opening_line",
        "arguments",
        "products",
        "objections"
      ]
    },
    "DossierView": {
      "type": "object",
      "properties": {
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "price_level": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "low",
                "mid",
                "premium"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fact_type": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false,
            "required": [
              "fact_type",
              "value",
              "source_url",
              "retrieved_at"
            ]
          }
        },
        "competitor_brands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "facts",
        "competitor_brands"
      ]
    },
    "VisitCard": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "customer",
            "prospect"
          ]
        },
        "account": {
          "$ref": "../_defs.json#/$defs/AccountRef"
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contact_id": {
                "type": "string",
                "format": "uuid"
              },
              "full_name": {
                "type": "string"
              },
              "role_title": {
                "anyOf": [
                  {
                    "type": "string"
