{
  "name": "debrief",
  "display_name": "Debrief",
  "description": "Use when: rep describes a visit.",
  "prompts": {
    "skill": "prompt.md"
  },
  "tools": {
    "resolve_account": {
      "type": "programmable",
      "parameters": [
        {
          "name": "hint",
          "type": "string",
          "required": false,
          "is_exposed_to_llm": true
        }
      ],
      "config": {
        "timeout": 12000,
        "is_interruptible": true
      }
    },
    "log_visit": {
      "type": "programmable",
      "parameters": [
        {
          "name": "utterance",
          "type": "string",
          "required": true,
          "is_exposed_to_llm": true
        },
        {
          "name": "account_id",
          "type": "string",
          "required": false,
          "is_exposed_to_llm": true,
          "description": "UUID taken from an earlier tool result"
        }
      ],
      "config": {
        "timeout": 30000,
        "is_interruptible": false
      }
    },
    "get_debrief_result": {
      "type": "programmable",
      "parameters": [
        {
          "name": "voice_log_id",
          "type": "string",
          "required": true,
          "is_exposed_to_llm": true,
          "description": "UUID taken from an earlier tool result"
        }
      ],
      "config": {
        "timeout": 12000,
        "is_interruptible": true
      }
    },
    "undo_action": {
      "type": "programmable",
      "parameters": [
        {
          "name": "ai_action_id",
          "type": "string",
          "required": true,
          "is_exposed_to_llm": true,
          "description": "UUID taken from an earlier tool result"
        }
      ],
      "config": {
        "timeout": 12000,
        "is_interruptible": false
      }
    },
    "resolve_approval": {
      "type": "programmable",
      "parameters": [
        {
          "name": "approval_id",
          "type": "string",
          "required": true,
          "is_exposed_to_llm": true,
          "description": "UUID taken from an earlier tool result"
        },
        {
          "name": "decision",
          "type": "enum",
          "required": true,
          "is_exposed_to_llm": true,
          "enum_values": [
            "approve",
            "edit_approve",
            "reject"
          ]
        },
        {
          "name": "final_body",
          "type": "string",
          "required": false,
          "is_exposed_to_llm": true
        }
      ],
      "config": {
        "timeout": 30000,
        "is_interruptible": false
      }
    }
  }
}
