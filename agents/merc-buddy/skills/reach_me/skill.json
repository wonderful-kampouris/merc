{
  "name": "reach_me",
  "display_name": "Reach Me",
  "description": "Use when: 'call me at 5' / 'ping me on WhatsApp when it's approved'.",
  "prompts": {
    "skill": "prompt.md"
  },
  "tools": {
    "call_me_back": {
      "type": "programmable",
      "parameters": [
        {
          "name": "channel",
          "type": "enum",
          "required": false,
          "is_exposed_to_llm": true,
          "enum_values": [
            "call",
            "whatsapp"
          ]
        },
        {
          "name": "purpose",
          "type": "enum",
          "required": true,
          "is_exposed_to_llm": true,
          "enum_values": [
            "callback",
            "briefing",
            "approval_decided",
            "alert",
            "eod",
            "pre_visit",
            "post_visit",
            "debrief_confirm"
          ]
        },
        {
          "name": "reason",
          "type": "string",
          "required": false,
          "is_exposed_to_llm": true
        },
        {
          "name": "at",
          "type": "string",
          "required": false,
          "is_exposed_to_llm": true,
          "description": "ISO 8601 date-time"
        },
        {
          "name": "ref_table",
          "type": "string",
          "required": false,
          "is_exposed_to_llm": true
        },
        {
          "name": "ref_id",
          "type": "string",
          "required": false,
          "is_exposed_to_llm": true
        }
      ],
      "config": {
        "timeout": 12000,
        "is_interruptible": false
      }
    },
    "report_buddy_call_outcome": {
      "type": "programmable",
      "parameters": [
        {
          "name": "buddy_call_id",
          "type": "string",
          "required": true,
          "is_exposed_to_llm": true,
          "description": "UUID taken from an earlier tool result"
        },
        {
          "name": "outcome",
          "type": "enum",
          "required": true,
          "is_exposed_to_llm": true,
          "enum_values": [
            "answered",
            "no_answer",
            "busy",
            "voicemail",
            "failed"
          ]
        }
      ],
      "config": {
        "timeout": 12000,
        "is_interruptible": false
      }
    }
  }
}
